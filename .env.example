# Vorlage fuer .env  —  echte Werte NIEMALS committen (CLAUDE.md §6).
# Kopieren nach .env und ausfuellen:  cp .env.example .env

# === Engine-API-Keys (Secrets) ===
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx   # einzige Live-Engine in Sprint 1
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx          # Claude  (Fast-Follow, S1 = Mock)
OPENAI_API_KEY=sk-xxxxxxxx                 # ChatGPT (Fast-Follow, S1 = Mock)
GOOGLE_API_KEY=xxxxxxxx                    # Gemini  (Fast-Follow, S1 = Mock)

# === Proxies ===
# Pfad zur Webshare-Liste im Format  ip:port:user:pass  (eine Zeile pro Proxy)
GEO_PROXY_FILE=Webshare 20 proxies (8).txt

# === Run-Steuerung ===
# Leer = alle Engines gemockt. Komma-Liste fuer Live-Engines, z.B. "perplexity".
GEO_LIVE_ENGINES=
GEO_RUN_SEED=42                            # Reproduzierbarkeit (Proxy-Rotation, Mock)

# === Budget-Cap pro Run (hartes Limit; bei Ueberschreitung -> BudgetExceeded) ===
GEO_MAX_PROBES=240
GEO_MAX_USD=2.00
GEO_MAX_TOKENS=2000000

# === Pfade ===
GEO_DB_PATH=runs/geo_audit.db
