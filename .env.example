# Vorlage fuer .env  —  echte Werte NIEMALS committen (CLAUDE.md §6).
# Kopieren nach .env und ausfuellen:  cp .env.example .env

# === Engine-API-Keys (Secrets) ===
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx   # Live-Engine (kostenpflichtig)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx          # Claude-Reasoning (kostenpflichtig)
OPENAI_API_KEY=sk-xxxxxxxx                 # ChatGPT (Mock; kein Live-Adapter)
# Gemini: KOSTENLOSER Key (keine Kreditkarte) von https://aistudio.google.com/apikey
# -> echte Google-Suche mit Quellen, Free Tier: 500 Grounding-Anfragen/Tag (Stand 2026-06).
# Mehrere Keys aus verschiedenen Google-Projekten per Komma trennen = hoeheres
# Tageskontingent (der Adapter rotiert bei Kontingent-Erschoepfung zum naechsten Key):
#   GOOGLE_API_KEY=key_projekt_a,key_projekt_b
GOOGLE_API_KEY=xxxxxxxx

# === SAIA / KISSKI (Hochschul-LLM, kostenlos; OpenAI-kompatibel) ===
# Key beantragen: KISSKI "LLM Service" -> "Book" (mit der AcademicCloud-Mailadresse).
SAIA_API_KEY=xxxxxxxx
# GEO_SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
# GEO_SAIA_MODEL=openai-gpt-oss-120b

# === Proxies ===
# Pfad zur Webshare-Liste im Format  ip:port:user:pass  (eine Zeile pro Proxy)
GEO_PROXY_FILE=Webshare 20 proxies (8).txt

# === Run-Steuerung ===
# Leer = alle Engines gemockt. Komma-Liste fuer Live-Engines, z.B. "gemini" oder "perplexity,gemini".
GEO_LIVE_ENGINES=
# Reasoning-Provider fuer Pattern-Miner/GEO-Auditor: mock (Default) | saia (kostenlos) | claude
GEO_REASONING_PROVIDER=mock
GEO_RUN_SEED=42                            # Reproduzierbarkeit (Proxy-Rotation, Mock)

# === Budget-Cap pro Run (hartes Limit; bei Ueberschreitung -> BudgetExceeded) ===
GEO_MAX_PROBES=240
GEO_MAX_USD=2.00
GEO_MAX_TOKENS=2000000

# === Pfade ===
GEO_DB_PATH=runs/geo_audit.db
