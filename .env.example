# Vorlage fuer .env  —  echte Werte NIEMALS committen (CLAUDE.md §6).
# Kopieren nach .env und ausfuellen:  cp .env.example .env
# Alle Werte sind opt-in: ohne Keys laeuft das System vollstaendig offline (Mock, deterministisch).

# === Engine-API-Keys (Secrets) ===
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx   # Live-Engine (Pay-as-you-go; Kostenlimit im Konto setzen)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx          # Claude-Reasoning (kostenpflichtig)
OPENAI_API_KEY=sk-xxxxxxxx                 # ChatGPT-Live-Engine (opt-in, kostenpflichtig — Kostenwarnung im README)
# Gemini: KOSTENLOSER Key (keine Kreditkarte) von https://aistudio.google.com/apikey
# -> echte Google-Suche mit Quellen im Free Tier. Das konkrete Modell pinnt die
#    Engine-Registry (config/engines.py) — bei Google-Abschaltungen nur dort tauschen.
# Mehrere Keys aus verschiedenen Google-Projekten per Komma trennen = hoeheres
# Tageskontingent (der Adapter rotiert bei Kontingent-Erschoepfung zum naechsten Key):
#   GOOGLE_API_KEY=key_projekt_a,key_projekt_b
GOOGLE_API_KEY=xxxxxxxx

# === SAIA / KISSKI (Hochschul-LLM, kostenlos; OpenAI-kompatibel) ===
# Key beantragen: KISSKI "LLM Service" -> "Book" (mit der AcademicCloud-Mailadresse).
SAIA_API_KEY=xxxxxxxx
# GEO_SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
# GEO_SAIA_MODEL=openai-gpt-oss-120b

# === SERP-Sichtbarkeit (Serper.dev: Google-Top-10 vs. AI-Zitate -> OverlapReport) ===
# Konto per E-Mail auf https://serper.dev -> Dashboard -> API-Key (2.500 Queries/Monat frei).
SERPER_API_KEY=xxxxxxxx
# off (Default, kein SERP-Schritt — Offline-Fingerprint bleibt unveraendert)
# | mock (offline-deterministisch, fuer Demo/Golden) | serper (live).
GEO_SERP_PROVIDER=off
# GEO_SERP_TOP_K=10                        # Google-Top-K als Vergleichsmenge
# GEO_SERP_QUERY_SET_VERSION=v1            # prompts/serp_queries.<version>.toml

# === IndexNow (Re-Indexierung nach ECHTEM Deploy; Bing/Yandex/Naver/Seznam) ===
# Key generieren (https://www.indexnow.org oder eine UUID) und als <key>.txt ins Webroot
# der Ziel-Site legen (Dateiinhalt = der Key; erreichbar unter https://<host>/<key>.txt).
# Google unterstuetzt IndexNow NICHT -> Sitemap in der Search Console einreichen.
# INDEXNOW_KEY=xxxxxxxxxxxxxxxx
# Abweichender Standort der Key-Datei (Default: https://<host>/<key>.txt):
# GEO_INDEXNOW_KEY_LOCATION=
# Opt-in: nur true UND CLI --notify-index UND non-dry-run-Deploy reichen URLs ein.
GEO_NOTIFY_INDEX=false

# === WordPress-Live-Deploy (Doppel-Gate; HITL-Freigabe bleibt immer hart) ===
# Application Password: WP-Admin -> Benutzer -> Profil -> "Anwendungspasswoerter" -> neu erzeugen.
# GEO_WP_BASE_URL=https://alte-test-site.example
# WP_USERNAME=admin
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Gate: echte Writes nur mit GEO_ALLOW_REMOTE=true UND CLI --allow-remote (Backup vor jedem Write).
GEO_ALLOW_REMOTE=false
# Deploy-Ziel: mock (Default, Dry-Run, kein Write) | filesystem (Artefakte nach runs/<id>/patches/)
# | wordpress (echte Site — ohne allow_remote-Gate -> ConfigError).
GEO_PUBLISHER=mock

# === Proxies (optional) ===
# Pfad zur Webshare-Liste im Format  ip:port:user:pass  (eine Zeile pro Proxy).
# Leer lassen = kein Proxy-Pool, alle Anfragen gehen direkt.
GEO_PROXY_FILE=Webshare 20 proxies (8).txt

# === Run-Steuerung ===
# Leer = alle Engines gemockt. Komma-Liste fuer Live-Engines, z.B. "gemini" oder "perplexity,gemini".
GEO_LIVE_ENGINES=
# Reasoning-Provider fuer Pattern-Miner/GEO-Auditor: mock (Default) | saia (kostenlos) | claude
GEO_REASONING_PROVIDER=mock
GEO_RUN_SEED=42                            # Reproduzierbarkeit (Proxy-Rotation, Mock)
# GEO_N_PROXY_IPS=5                        # IPs je Matrix-Zelle (Free-Tier-Tipp: 1 => 12 Anfragen/Lauf)
# GEO_TOP_N=10                             # Laenge der Top-/Flop-Liste
# GEO_PROMPT_SET_VERSION=v1                # prompts/probe_set.<version>.toml

# === Budget-Cap pro Run (hartes Limit; bei Ueberschreitung -> BudgetExceeded) ===
# Hinweis: --learn (Sprint 4) probt zweimal (Baseline + Re-Probe); der Cap wird intern
# fuer diesen Lauf verdoppelt, GEO_MAX_PROBES bleibt der Baseline-Wert.
GEO_MAX_PROBES=240
GEO_MAX_USD=2.00
GEO_MAX_TOKENS=2000000
# Pro-Provider-Request-Quoten (zusaetzlich zu den globalen Caps; ungesetzt = unbegrenzt):
# GEO_MAX_REQUESTS_SERPER=24               # schont das Serper-Freikontingent (2.500/Monat)
# GEO_MAX_REQUESTS_GEMINI=500              # Gemini-Free-Tier-Tageslimit nicht ueberschreiten

# === Gedaechtnis / Lern-Loop (Sprint 4) ===
# mock (Default, deterministisch, SQLite) | chroma (bge-m3-Embeddings, semantisch).
# chroma braucht das optionale Extra:  uv sync --extra memory   (zieht torch, ~2 GB).
GEO_MEMORY_PROVIDER=mock
# GEO_CHROMA_PATH=runs/chroma
# GEO_EMBEDDING_MODEL=BAAI/bge-m3

# === Pfade ===
GEO_DB_PATH=runs/geo_audit.db
# GEO_RUNS_DIR=runs                        # Wurzel fuer Run-Artefakte (patches/, backups/)

# === Tests ===
# Live-Tests (tests/live/, Marker @live) laufen NUR mit Opt-in + jeweiligem API-Key:
# GEO_RUN_LIVE_TESTS=1
